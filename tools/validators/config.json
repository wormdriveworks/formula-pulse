{
 "schema_version": 1,
 "tables_dir": "godot/data/tables",
 "structures_dir": "godot/data/structures",
 "strings_csv": "godot/data/strings/strings.csv",
 "string_language_columns": [
  "ko"
 ],
 "code_dir": "godot",
 "core_dir": "godot/core",
 "tables": {
  "core_params.csv": {
   "id_prefix": "param_",
   "root": true,
   "columns": {
    "id": "id",
    "value": "float"
   }
  },
  "symbol_distribution.csv": {
   "id_prefix": "symbol_",
   "root": true,
   "columns": {
    "id": "id",
    "class": "enum:forward,defense,control,resource,hazard,rare",
    "name_key": "string_key",
    "prob_reel1": "float",
    "prob_reel2": "float",
    "prob_reel3": "float"
   }
  },
  "symbol_match_effects.csv": {
   "id_prefix": "match_",
   "root": true,
   "columns": {
    "id": "id",
    "symbol_id": "fk:symbol_distribution.csv",
    "match_count": "int:1,3",
    "front_gauge": "float",
    "rear_gauge": "float",
    "charge": "float",
    "chassis": "float",
    "special": "enum_optional:duel_trigger"
   }
  },
  "duel_conversion.csv": {
   "id_prefix": "duel_",
   "root": true,
   "columns": {
    "id": "id",
    "symbol_id": "fk:symbol_distribution.csv",
    "mode": "enum:overtake_primary,defense_primary,always",
    "match1": "float",
    "match2": "float",
    "match3": "float",
    "per_symbol": "float"
   }
  },
  "ai_teams.csv": {
   "id_prefix": "team_",
   "root": false,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "pace_add": "float",
    "aggression_add": "float",
    "stability_add": "float",
    "rush_lap_final_add": "float",
    "pressure_mult": "float"
   }
  },
  "ai_rivals.csv": {
   "id_prefix": "ai_",
   "root": false,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "team_id": "fk:ai_teams.csv",
    "pace": "float",
    "aggression": "float",
    "rush_lap1": "float",
    "rush_lap_final": "float",
    "rush_random": "float",
    "stability": "float",
    "start_mod": "float",
    "form_var": "float",
    "duel_overtake_add": "float",
    "duel_defense_override": "float_optional",
    "stability_under_pressure": "float_optional"
   }
  },
  "points_tier1.csv": {
   "id_prefix": "point_",
   "root": true,
   "columns": {
    "id": "id",
    "position": "int:1,16",
    "points": "int"
   }
  },
  "sector_attributes.csv": {
   "id_prefix": "attr_",
   "root": false,
   "columns": {
    "id": "id",
    "code": "enum:A1,A2,A3,A4,A5,A6",
    "name_key": "string_key",
    "w_forward": "float",
    "w_defense": "float",
    "w_control": "float",
    "w_resource": "float",
    "w_hazard": "float",
    "w_rare": "float",
    "chassis_wear_mult": "float",
    "gauge_mult": "float"
   }
  },
  "presentation_grades.csv": {
   "id_prefix": "grade_",
   "root": true,
   "columns": {
    "id": "id",
    "code": "enum:L0,L1,L2,L3",
    "gp_cap": "int:0,9",
    "sfx_sting": "int:0,1",
    "haptic_level": "enum:none,weak,strong",
    "flash_slow": "int:0,1",
    "illustration": "int:0,1",
    "sting_length_sec": "float"
   }
  },
  "presentation_triggers.csv": {
   "id_prefix": "trigger_",
   "root": true,
   "columns": {
    "id": "id",
    "grade_id": "fk:presentation_grades.csv",
    "priority": "int:1,9"
   }
  },
  "event_categories.csv": {
   "id_prefix": "category_",
   "root": true,
   "columns": {
    "id": "id",
    "code": "enum:C1,C2,C3,C4,C5",
    "name_key": "string_key",
    "weight": "float",
    "reward_type": "enum:chassis,credit,dp,relation,info,none",
    "reward_min": "int",
    "reward_max": "int",
    "rare_probability": "float",
    "rare_dp": "int"
   }
  },
  "events.csv": {
   "id_prefix": "event_",
   "root": true,
   "columns": {
    "id": "id",
    "category_id": "fk:event_categories.csv",
    "name_key": "string_key",
    "scope": "enum:common,stage"
   }
  },
  "points_tier2.csv": {
   "id_prefix": "point2_",
   "root": true,
   "columns": {
    "id": "id",
    "position": "int:1,16",
    "points": "int"
   }
  },
  "garage_facilities.csv": {
   "id_prefix": "facility_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "effect": "enum:archive_deep_tab,recall_playback,deck_preset_slot,sponsor_slot_plus",
    "cost_dp": "int",
    "requires_crew": "fk_optional:crew.csv"
   }
  },
  "tuning_lines.csv": {
   "id_prefix": "tuning_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "target": "string",
    "effect_per_step": "float",
    "effect_unit": "enum:ratio,flat",
    "cost1": "int",
    "cost2": "int",
    "cost3": "int",
    "cost4": "int",
    "cost5": "int"
   }
  },
  "overhauls.csv": {
   "id_prefix": "overhaul_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "kind": "enum:trait,sidegrade,part",
    "effect": "string",
    "effect_value": "float",
    "drawback": "string",
    "drawback_value": "float"
   }
  },
  "overhaul_slots.csv": {
   "id_prefix": "ovslot_",
   "root": true,
   "columns": {
    "id": "id",
    "rank_min": "int:1,16",
    "rank_max": "int:1,16",
    "slots": "int:1,4",
    "candidates": "int:1,12"
   }
  },
  "skills.csv": {
   "id_prefix": "skill_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "skill_tier": "int:1,3",
    "charge_cost": "int:0,9",
    "uses_per_tour": "int:0,9",
    "unlock_dp": "int",
    "family": "enum:hold,convert,amplify,insure",
    "effect": "string"
   }
  },
  "crew.csv": {
   "id_prefix": "crew_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "role": "string",
    "recruit_dp": "int",
    "passive": "string",
    "passive_value": "float"
   }
  },
  "sponsors.csv": {
   "id_prefix": "sponsor_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "kind": "enum:stable,aggressive,rivalry,prestige",
    "regular_cr": "int",
    "bonus_cr": "int",
    "condition": "string"
   }
  },
  "relation_axes.csv": {
   "id_prefix": "relation_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "rival_id": "fk:ai_rivals.csv",
    "counter_source": "string",
    "threshold1": "int:1,99",
    "threshold2": "int:1,99",
    "threshold3": "int:1,99"
   }
  },
  "consumables.csv": {
   "id_prefix": "consumable_",
   "root": true,
   "columns": {
    "id": "id",
    "name_key": "string_key",
    "cost_cr": "int",
    "effect": "string",
    "effect_value": "float"
   }
  },
  "settlement_rewards.csv": {
   "id_prefix": "reward_",
   "root": true,
   "columns": {
    "id": "id",
    "scope": "enum:tour,season",
    "rank_min": "int:1,16",
    "rank_max": "int:1,16",
    "credits": "int",
    "dp": "int"
   }
  }
 },
 "structures": {
  "content_manifest.json": {
   "root": true,
   "required": {
    "id": "string",
    "stages": "structure_ref_array",
    "circuits": "structure_ref_array",
    "scripted_losses": "structure_ref_array",
    "default_circuit": "structure_ref"
   }
  },
  "grid_debug.json": {
   "root": true,
   "required": {
    "id": "string",
    "rivals": "fk_array:ai_rivals.csv",
    "filler_count": "int",
    "player_start_position": "int"
   }
  },
  "circuit_mn1.json": {
   "root": true,
   "template": "circuit"
  },
  "circuit_mn2.json": {
   "root": true,
   "template": "circuit"
  },
  "circuit_mn3.json": {
   "root": true,
   "template": "circuit"
  },
  "circuit_mn4.json": {
   "root": true,
   "template": "circuit"
  },
  "stage_metro_night.json": {
   "root": true,
   "required": {
    "id": "string",
    "name_key": "string_key",
    "season1_tour_slot": "int:1,5",
    "circuits": "structure_ref_array",
    "wall_rival": "fk_optional:ai_rivals.csv",
    "resonance_bonus_type": "enum:charge,front_gauge,duel_judgment,chassis,front_gauge_full",
    "resonance_bonus_value": "float",
    "event_pool": "fk_array:events.csv"
   }
  },
  "scripted_loss_s1.json": {
   "root": true,
   "required": {
    "id": "string",
    "anchor_type": "string",
    "tour_slot": "int:1,5",
    "season": "int",
    "circuit_id": "structure_ref",
    "rival_id": "fk:ai_rivals.csv",
    "rule": "enum:overtake_duel_never",
    "player_best_rank": "int:1,16"
   }
  },
  "event_variants.json": {
   "root": true,
   "required": {
    "id": "string"
   }
  },
  "season_calendar.json": {
   "root": true,
   "required": {
    "id": "string",
    "tours_per_season": "int:1,9",
    "races_per_tour": "int:1,9",
    "fixed_opening_stage": "structure_ref",
    "fixed_final_stage": "string",
    "shuffle_pool": "structure_ref_array"
   }
  }
 },
 "structure_templates": {
  "circuit": {
   "required": {
    "id": "string",
    "name_key": "string_key",
    "stage_id": "structure_ref",
    "tour_slot_role": "enum:opener,build_a,build_b,finisher",
    "laps": "int:1,9",
    "sectors_per_lap": "int:1,9"
   },
   "arrays": {
    "sectors": {
     "count_field": "sectors_per_lap",
     "required": {
      "slot": "int:1,9",
      "name_key": "string_key",
      "main_attr": "fk:sector_attributes.csv",
      "sub_attr": "fk_optional:sector_attributes.csv"
     }
    }
   }
  }
 },
 "anchor_rule": {
  "anchor_field": "anchor_type",
  "allowed_anchor_types": [
   "milestone_act",
   "stage",
   "tour_slot"
  ],
  "tour_slot_field": "tour_slot",
  "allowed_tour_slots": [
   1,
   5
  ]
 },
 "string_write_rules": [
  {
   "domain_prefixes": [
    "raceLog.",
    "relay.",
    "vane."
   ],
   "max_lines": 2,
   "max_chars_full": 22
  },
  {
   "domain_prefixes": [
    "vn."
   ],
   "max_lines": 2,
   "max_chars_full": 24
  }
 ],
 "v7_domains": [
  "raceLog.",
  "relay.",
  "vane.",
  "vn."
 ],
 "v7_terms": [
  "FP",
  "확률",
  "슬롯",
  "스핀",
  "홀드",
  "릴"
 ],
 "key_regex": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*){1,2}$",
 "v4_whitelist_marker": "V4-except",
 "contamination_patterns": [
  "OS.get_name",
  "OS.has_feature",
  "DisplayServer.",
  "Engine.has_singleton",
  "platform ==",
  "platform==",
  "AdMob",
  "admob",
  "Steamworks",
  "GameCenter",
  "Play Games",
  "iCloud",
  "res://platform/",
  "advert",
  "iap_",
  "purchase",
  "reward_video"
 ],
 "v4_exempt_dirs": [
  "godot/tests"
 ],
 "v4_display_sinks": [
  "text",
  "tooltip_text",
  "placeholder_text"
 ],
 "key_scan_excluded_suffixes": [
  ".json",
  ".csv",
  ".tsv",
  ".tres",
  ".tscn",
  ".gd",
  ".cfg",
  ".png",
  ".ogg",
  ".wav",
  ".bak"
 ],
 "architecture_rules": [
  {
   "name": "세이브 정책 층 우회 금지",
   "reason": "SaveManager 경유 — 직접 호출은 백업 회전·프로필 분리·마이그레이션을 우회한다",
   "forbidden": [
    "SaveService.save_to",
    "SaveService.load_from",
    "SaveService.delete_save"
   ],
   "scope": [
    "godot"
   ],
   "allow": [
    "godot/core/save",
    "godot/tests"
   ]
  },
  {
   "name": "코어 표준출력 금지",
   "reason": "코어는 순수 로직이며 출력 경로를 갖지 않는다 — print·push_warning은 봉인 규칙의 누출 경로다 (push_error는 값 누락 보고에 정당한 용도가 있어 제외)",
   "forbidden": [
    "print(",
    "print_rich(",
    "printt(",
    "prints(",
    "printraw(",
    "push_warning("
   ],
   "scope": [
    "godot/core",
    "godot/ui"
   ],
   "allow": []
  }
 ]
}