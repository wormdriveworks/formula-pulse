; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Formula Pulse: Spin the Grid"
config/version="0.2.0"
run/main_scene="res://ui/flow/app_root.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input]

; **D09 §1.3 공통 층 매핑표의 기계 전사** — 전건 정본 명문이라 [가안] 없음 (IMPL-186).
; 엔진 기본 바인딩은 키보드 위주라 패드 행이 비어 있었다(실측). 아래는 그 보완이다.
;
; ⚠ `[input]` 에 액션을 적으면 **엔진 기본 이벤트를 대체**한다 — 기존 키보드 바인딩을
; 함께 적지 않으면 사라진다. 그래서 각 액션이 매핑표의 키보드·패드 열을 모두 담는다.
;
; `ui_up/down/left/right`(포커스 이동)는 **엔진 기본이 이미 D패드 + 좌스틱을 담고 있어**
; 여기 적지 않는다 — 부분 전사로 오히려 잃을 위험이 크다(실측 근거는 5차 회신 §1).
; 계약의 고정은 UISCR 의 액션·바인딩 존재 단언이 맡는다.

; 확인 / 선택 = Enter · 좌클릭 | A
ui_accept={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
