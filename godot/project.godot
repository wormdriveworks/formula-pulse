; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Formula Pulse: Spin the Grid"
config/version="0.2.0"
run/main_scene="res://ui/flow/app_root.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

; ── 부트 스플래시 (배치 대장 §6.1 참조처 이행 · 총괄 판정 IMPL-499 ②) ──
;
; 기본 Godot 스플래시로는 제출할 수 없다. 실물은 키 비주얼 리프레임 640×360 이며
; 캔버스와 같은 치수라 1920×1080 창에서 정수 3배로 놓인다.
;
; ⚠ `use_filter=false` 가 규격이다 — 부트 스플래시는 씬 트리 이전에 그려지므로
; `default_texture_filter=0`(전역 니어리스트)의 적용을 받지 않는다. 켜 두면 도트가
; 보간되어 D10 §2.2 믹셀 금지에 저촉한다. 전역 설정과 별개의 축이라 여기 명시한다.
;
; `bg_color` 는 팔레트 `BG_DEEP`(마스터 N01 `#080B11`) 전사다 — 창 종횡비가 16:9 가
; 아닐 때만 보이는 여백색이고, 값의 출처는 조달 대장이다(불변규칙 2 별첨A 위임).
boot_splash/bg_color=Color(0.0313726, 0.0431373, 0.0666667, 1)
boot_splash/image="res://assets/platform/boot_splash.png"
boot_splash/use_filter=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input]

; **D09 §1.3 공통 층 매핑표의 기계 전사** — 전건 정본 명문이라 [가안] 없음 (IMPL-186).
; 엔진 기본 바인딩은 키보드 위주라 패드 행이 비어 있었다(실측). 아래는 그 보완이다.
;
; ⚠ `[input]` 에 액션을 적으면 **엔진 기본 이벤트를 대체**한다 — 기존 키보드 바인딩을
; 함께 적지 않으면 사라진다. 그래서 각 액션이 매핑표의 키보드·패드 열을 모두 담는다.
;
; `ui_up/down/left/right`(포커스 이동)는 **엔진 기본이 이미 D패드 + 좌스틱을 담고 있어**
; 여기 적지 않는다 — 부분 전사로 오히려 잃을 위험이 크다(실측 근거는 5차 회신 §1).
; 계약의 고정은 UISCR 의 액션·바인딩 존재 단언이 맡는다.

; 확인 / 선택 = Enter · 좌클릭 | A
